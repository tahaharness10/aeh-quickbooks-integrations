# QuickBooks credentials (shared with qb-sync)
QUICKBOOKS_CLIENT_ID=your_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_client_secret_here
QUICKBOOKS_REFRESH_TOKEN=your_refresh_token_here
QUICKBOOKS_COMPANY_ID=your_company_id_here

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Local dev fallback
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/your/service_account.json

# Name of the Google Sheet to update (create this sheet first and share it with the service account email)
GOOGLE_SHEET_NAME=Najmi_Contributions

# Comma-separated list of QuickBooks Income Account names to pull contributions from
CONTRIBUTION_ACCOUNTS=Sabil ul khair,Faizul Mawaidil Burhaniya

# Date range for contributions (YYYY-MM-DD). Leave START_DATE blank to default to Jan 1 of current year.
CONTRIBUTIONS_START_DATE=
CONTRIBUTIONS_END_DATE=

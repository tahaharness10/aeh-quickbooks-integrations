# QuickBooks credentials
# client_id and client_secret come from your Intuit Developer app
QUICKBOOKS_CLIENT_ID=your_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_client_secret_here

# Refresh token — stored as a GitHub Variable (not Secret) so the workflow can update it
QUICKBOOKS_REFRESH_TOKEN=your_refresh_token_here

# Company/Realm ID (found in QuickBooks URL or Intuit Developer portal)
QUICKBOOKS_COMPANY_ID=your_company_id_here

# Google Sheets
# On Railway/GitHub Actions: paste the full contents of your service account JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Local dev only: path to the service account JSON file (used if GOOGLE_SERVICE_ACCOUNT_JSON is not set)
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/your/service_account.json

# Name of the Google Sheet to update
GOOGLE_SHEET_NAME=Najmi_QH_Balances
